{
  "name": "terrarium-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for the Terrarium desktop app",
  "type": "module",
  "private": true,
  "bin": {
    "terrarium-mcp": "terrarium-mcp.ts"
  },
  "scripts": {
